  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String    @map("assessment_id") @db.Uuid
  hostname       String
  ipAddress      String?   @map("ip_address")
  assetType      AssetType @map("asset_type")
  osType         String?   @map("os_type")
  osVersion      String?   @map("os_version")
  criticality    String?   @default("MEDIUM")
  environmentId  String?   @map("environment_id") @db.Uuid // Links to Tenant
  regionId       String?   @map("region_id") @db.Uuid
  owner          String?
  internetFacing Boolean   @default(false) @map("internet_facing")
  discoveredDate DateTime  @default(now()) @map("discovered_date")
  metadata       Json?     @default("{}")
  resourceId     String?   @unique @map("resource_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid

  resource Resource? @relation(fields: [resourceId], references: [id])
  customer Customer? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assessment      DiscoveryAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  tenant          Tenant?                   @relation(fields: [environmentId], references: [id])
  region          LookupRegion?             @relation(fields: [regionId], references: [id])
  accounts        DiscoveryAccount[]
