generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  engineType      = "library"
  output          = "../src/generated/prisma-client"
}

// Second generator writes to the default node_modules/.prisma/client location,
// keeping @prisma/client (already in serverExternalPackages) in sync with the
// current schema so webpack never bundles the Prisma WASM binary.
generator clientDefault {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "public", "studio", "discovery", "security"]
}

model Resource {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @map("resource_id") @db.Uuid
  tenantId            String?              @map("tenant_id") @db.Uuid
  parentResourceId    String?              @map("parent_resource_id") @db.Uuid
  resourceType        ResourceType         @map("resource_type")
  name                String
  ownerType           String?              @map("owner_type")
  ownerId             String?              @map("owner_id") @db.Uuid
  status              String               @default("ACTIVE")
  metadata            String               @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  isLocked            Boolean              @default(false) @map("is_locked")
  customer            Customer?
  folder              Folder?
  appGroup            AppGroup?
  project             Project?
  appRole             AppRole?
  studioWorkflow      StudioWorkflow?
  tenant              Tenant?
  workspace           Workspace?
  application         Application?
  discoveryAssessment DiscoveryAssessment?
  discoveryAsset      DiscoveryAsset?
  discoveryConnector  DiscoveryConnector?

  @@map("resources")
  @@schema("platform")
}

model Customer {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName            String                @map("company_name")
  slug                   String?               @unique @map("slug")
  isRegistrationEnabled  Boolean               @default(false) @map("is_registration_enabled")
  industry               String                @map("industry")
  location               String                @map("location")
  status                 String                @default("Pending Approval") @map("status")
  classification         String?               @map("classification")
  priority               String?               @default("Standard") @map("priority")
  description            String?               @map("description")
  createdBy              String?               @map("created_by")
  customerType           String?               @default("Enterprise") @map("customer_type")
  customerTier           String?               @default("Enterprise") @map("customer_tier")
  displayName            String?               @map("display_name")
  currency               String                @default("USD") @map("currency")
  timezone               String                @default("UTC") @map("timezone")
  language               String                @default("en") @map("language")
  supportEmail           String?               @map("support_email")
  authType               String                @default("Email + Password") @map("auth_type")
  allowedDomains         String?               @map("allowed_domains")
  mfaEnforced            Boolean               @default(false) @map("mfa_enforced")
  complianceMode         String                @default("Standard") @map("compliance_mode")
  retentionPolicyDays    Int?                  @default(30) @map("retention_policy_days")
  dataResidencyRegion    String?               @map("data_residency_region")
  planType               String                @default("Free") @map("plan_type")
  contractStartDate      DateTime              @default(now()) @map("contract_start_date")
  billingEntity          String?               @map("billing_entity")
  billingEmail           String?               @map("billing_email")
  aiEnabled              Boolean               @default(true) @map("ai_enabled")
  studioAccess           Boolean               @default(true) @map("studio_access")
  apiAccess              Boolean               @default(true) @map("api_access")
  marketplaceAccess      Boolean               @default(true) @map("marketplace_access")
  tags                   String?               @map("tags")
  accountOwner           String?               @map("account_owner")
  onboardingSource       String?               @map("onboarding_source")
  offboardingStatus      String?               @map("offboarding_status")
  offboardingMode        String?               @map("offboarding_mode")
  compliancePackagePath  String?               @map("compliance_package_path")
  compliancePackageHash  String?               @map("compliance_package_hash")
  offboardingInitiatedAt DateTime?             @map("offboarding_initiated_at")
  offboardingExpiresAt   DateTime?             @map("offboarding_expires_at")
  isGovernanceLocked     Boolean               @default(false) @map("is_governance_locked")
  logoUrl                String?               @map("logo_url")
  theme                  String?               @default("Sand Serenity") @map("theme")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  resourceId             String?               @unique @map("resource_id") @db.Uuid
  engagementTier         String?               @default("Bronze") @map("engagement_tier")
  subscriptionPlanId     String?               @map("subscription_plan_id") @db.Uuid
  auditLogs              AuditLog[]
  automationWorkflows    AutomationWorkflow[]
  logFiles               CustomerLogFile[]
  resource               Resource?             @relation(fields: [resourceId], references: [id])
  subscriptionPlan       SubscriptionPlan?     @relation(fields: [subscriptionPlanId], references: [id])
  orgSettings            OrganizationSettings?
  resourceQuotas         ResourceQuota[]
  smtpConfig             SmtpConfig?
  tenantAdmins           TenantAdmin[]
  discoveryAssessments   DiscoveryAssessment[]
  discoveryAssets        DiscoveryAsset[]
  businessUnits          BusinessUnit[]
  tenants                Tenant[]
  users                  AppUser[]
  workspaces             Workspace[]
  intakeConnectors       IntakeConnector[]
  roles                  AppRole[]
  groups                 AppGroup[]
  mfaPolicy              MfaPolicy?
  sessionPolicy          SessionPolicy?

  @@map("customers")
  @@schema("platform")
}

model Tenant {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @map("name")
  code                String               @unique @map("code")
  description         String?              @map("description")
  type                String               @default("DEV") @map("type")
  status              String               @default("ACTIVE") @map("status")
  isDefault           Boolean              @default(false) @map("is_default")
  isProtected         Boolean              @default(false) @map("is_protected")
  isGovernanceLocked  Boolean              @default(false) @map("is_governance_locked")
  customerId          String               @map("customer_id") @db.Uuid
  resourceId          String?              @unique @map("resource_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  automationWorkflows AutomationWorkflow[]
  botHosts            BotHost[]
  deployments         Deployment[]
  jobs                StudioJob[]
  config              TenantConfig[]
  services            TenantService[]
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resource            Resource?            @relation(fields: [resourceId], references: [id])
  users               AppUser[]
  sovereignWorkflows  Workflow[]
  studioQueues        StudioQueue[]
  workspaces          Workspace[]
  discoveryAssets     DiscoveryAsset[]
  applications        Application[]
  intakeConnectors    IntakeConnector[]
  groups              AppGroup[]
  roleTenantScopes    RoleTenantScope[]
  mfaPolicy           MfaPolicy?
  sessionPolicy       SessionPolicy?

  @@index([customerId])
  @@map("tenants")
  @@schema("platform")
}

model TenantConfig {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  key      String
  value    String
  category String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_configs")
  @@schema("platform")
}

model TenantService {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  serviceName String
  enabled     Boolean  @default(false)
  enabledBy   String?
  enabledAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceName])
  @@map("tenant_services")
  @@schema("platform")
}

model TenantAdmin {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String
  lastName        String
  dob             String?
  gender          String?
  email           String
  employeeId      String?
  jobTitle        String?
  department      String?
  manager         String?
  employmentType  String
  workLocation    String
  phone           String?
  role            String   @default("Admin")
  startDate       String?
  endDate         String?
  mfaEnabled      Boolean  @default(false)
  customerId      String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          String   @default("Active")
  activationToken String?  @map("activation_token")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("tenant_admins")
  @@schema("platform")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp   DateTime  @default(now())
  actor       String    @default("System")
  action      String
  target      String?
  details     String?
  ipAddress   String?
  userAgent   String?
  severity    String    @default("Info")
  isChronicle Boolean   @default(false)
  customerId  String?   @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([timestamp])
  @@map("audit_logs")
  @@schema("platform")
}

model SecurityCredential {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  ownerId     String?   @db.Uuid
  privateKey  String
  certificate String
  isActive    Boolean   @default(true)
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
  @@index([type])
  @@map("security_credentials")
  @@schema("platform")
}

model AppUser {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique
  fullName           String?
  externalId         String?
  authMethod         String     @default("local")
  status             String     @default("active")
  isEmailVerified    Boolean    @default(false)
  verificationToken  String?
  lastLogin          DateTime?
  isGovernanceLocked Boolean    @default(false)
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaMethod          String?    @map("mfa_method")
  jobTitle           String?    @map("job_title")
  department         String?
  avatarUrl          String?    @map("avatar_url")
  customerId         String?    @db.Uuid
  tenantId           String?    @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customer           Customer?  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant             Tenant?    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups             AppGroup[] @relation("AppGroupToAppUser")
  roles              AppRole[]  @relation("AppRoleToAppUser")
  permissionOverrides UserPermissionOverride[]
  accessRequestsFrom  AccessRequest[] @relation("AccessRequestRequester")
  accessRequestsFor   AccessRequest[] @relation("AccessRequestTarget")

  @@map("users")
  @@schema("platform")
}

model AppRole {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @unique
  description  String?
  isSystem     Boolean   @default(false)
  isCustom     Boolean   @default(false) @map("is_custom")
  permissions  String?
  scope        String    @default("tenant")         // platform | customer | tenant
  color        String?                               // UI badge color
  icon         String?                               // icon key
  parentRoleId String?   @map("parent_role_id") @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  resourceId   String?   @unique @map("resource_id") @db.Uuid

  mappings        GroupMapping[]
  resource        Resource?          @relation(fields: [resourceId], references: [id])
  users           AppUser[]          @relation("AppRoleToAppUser")
  parentRole      AppRole?           @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles      AppRole[]          @relation("RoleHierarchy")
  customer        Customer?          @relation(fields: [customerId], references: [id])
  rolePermissions RolePermission[]
  tenantScopes    RoleTenantScope[]
  sodRulesA       SodRule[]          @relation("SodRoleA")
  sodRulesB       SodRule[]          @relation("SodRoleB")

  @@map("roles")
  @@schema("platform")
}

model AppGroup {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @unique
  description String?
  customerId  String?        @map("customer_id") @db.Uuid
  tenantId    String?        @map("tenant_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  resourceId  String?        @unique @map("resource_id") @db.Uuid
  mappings    GroupMapping[]
  resource    Resource?      @relation(fields: [resourceId], references: [id])
  users       AppUser[]      @relation("AppGroupToAppUser")
  customer    Customer?      @relation(fields: [customerId], references: [id])
  tenant      Tenant?        @relation(fields: [tenantId], references: [id])

  @@map("groups")
  @@schema("platform")
}

// ─── Fine-grained permission catalog ────────────────────────────────────────

model PermissionDefinition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String                  // automation, ai_model, application, document …
  action      String                  // view, create, modify, execute, publish, delete …
  displayName String    @map("display_name")
  description String?
  category    String                  // Automation, AI, Security, Admin …
  isSystem    Boolean   @default(true) @map("is_system")

  rolePermissions    RolePermission[]
  userOverrides      UserPermissionOverride[]

  @@unique([resource, action])
  @@map("permission_definitions")
  @@schema("platform")
}

model RolePermission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  effect       String    @default("ALLOW")          // ALLOW | DENY
  conditions   Json?                                 // optional ABAC conditions

  role       AppRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("platform")
}

// Per-user permission overrides (direct grants / denies)
model UserPermissionOverride {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  effect       String    @default("ALLOW")          // ALLOW | DENY
  grantedBy    String    @map("granted_by")
  reason       String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       AppUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@map("user_permission_overrides")
  @@schema("platform")
}

// Attach a role to specific tenants (replication)
model RoleTenantScope {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  role   AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([roleId, tenantId])
  @@map("role_tenant_scopes")
  @@schema("platform")
}

// ─── Segregation of Duties ───────────────────────────────────────────────────

model SodRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleAId     String   @map("role_a_id") @db.Uuid
  roleBId     String   @map("role_b_id") @db.Uuid
  severity    String   @default("HIGH")              // HIGH | MEDIUM | LOW
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  roleA AppRole @relation("SodRoleA", fields: [roleAId], references: [id], onDelete: Cascade)
  roleB AppRole @relation("SodRoleB", fields: [roleBId], references: [id], onDelete: Cascade)

  @@unique([roleAId, roleBId])
  @@map("sod_rules")
  @@schema("platform")
}

// ─── MFA & Session Policies ──────────────────────────────────────────────────

model MfaPolicy {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String?  @unique @map("customer_id") @db.Uuid
  tenantId         String?  @unique @map("tenant_id") @db.Uuid
  isEnforced       Boolean  @default(true) @map("is_enforced")
  allowedMethods   Json     @default("[\"totp\",\"email_otp\"]") @map("allowed_methods")
  gracePeriodDays  Int      @default(7) @map("grace_period_days")
  bypassRoles      Json     @default("[]") @map("bypass_roles")  // role IDs exempt from MFA
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("mfa_policies")
  @@schema("platform")
}

model SessionPolicy {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId            String?  @unique @map("customer_id") @db.Uuid
  tenantId              String?  @unique @map("tenant_id") @db.Uuid
  sessionTimeoutMinutes Int      @default(60) @map("session_timeout_minutes")
  idleTimeoutMinutes    Int      @default(30) @map("idle_timeout_minutes")
  maxConcurrentSessions Int      @default(3) @map("max_concurrent_sessions")
  requireDeviceTrust    Boolean  @default(false) @map("require_device_trust")
  allowedIpRanges       Json     @default("[]") @map("allowed_ip_ranges")
  geoRestrictions       Json     @default("[]") @map("geo_restrictions")
  riskBasedAuthEnabled  Boolean  @default(false) @map("risk_based_auth_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("session_policies")
  @@schema("platform")
}

// ─── Access Request & Certification ──────────────────────────────────────────

model AccessRequest {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId  String   @map("requester_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  roleId       String?  @map("role_id") @db.Uuid
  permissionId String?  @map("permission_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  justification String?
  status       String   @default("PENDING")          // PENDING | APPROVED | REJECTED | EXPIRED
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  requester  AppUser   @relation("AccessRequestRequester", fields: [requesterId], references: [id])
  targetUser AppUser?  @relation("AccessRequestTarget", fields: [targetUserId], references: [id])

  @@map("access_requests")
  @@schema("platform")
}

model SubscriptionPlan {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @unique
  code          String     @unique
  description   String?
  defaultQuotas String     @default("{}")
  customers     Customer[]

  @@map("subscription_plans")
  @@schema("platform")
}

model ResourceQuota {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String       @map("customer_id") @db.Uuid
  resourceType ResourceType
  maxCount     Int          @default(10)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, resourceType])
  @@map("resource_quotas")
  @@schema("platform")
}

model IdentityProvider {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  type       String
  configJson String
  syncStatus String         @default("Healthy")
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  mappings   GroupMapping[]

  @@map("identity_providers")
  @@schema("platform")
}

model GroupMapping {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId        String           @db.Uuid
  externalGroupName String
  internalRoleId    String?          @db.Uuid
  internalGroupId   String?          @db.Uuid
  priority          Int              @default(1)
  internalGroup     AppGroup?        @relation(fields: [internalGroupId], references: [id])
  internalRole      AppRole?         @relation(fields: [internalRoleId], references: [id])
  provider          IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("group_mappings")
  @@schema("platform")
}

model StandardDictionary {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category String
  label    String
  isActive Boolean @default(true)
  priority Int     @default(1)

  @@unique([category, label])
  @@map("standard_dictionaries")
  @@schema("platform")
}

model LookupIndustry {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String  @unique
  value              String?
  icon               String?
  isActive           Boolean @default(true)
  isGovernanceLocked Boolean @default(false)

  @@map("lookup_industries")
  @@schema("platform")
}

model LookupRegion {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label                String                @unique
  value                String?
  icon                 String?
  category             String?
  isActive             Boolean               @default(true)
  isGovernanceLocked   Boolean               @default(false)
  discoveryAssets      DiscoveryAsset[]
  discoveryAssessments DiscoveryAssessment[]

  @@map("lookup_regions")
  @@schema("platform")
}

model LookupCurrency {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String  @unique
  code               String?
  symbol             String?
  isActive           Boolean @default(true)
  isGovernanceLocked Boolean @default(false)
  icon               String?

  @@map("lookup_currencies")
  @@schema("platform")
}

model LookupTimezone {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String  @unique
  isActive           Boolean @default(true)
  isGovernanceLocked Boolean @default(false)
  category           String?

  @@map("lookup_timezones")
  @@schema("platform")
}

model LookupCustomerType {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String  @unique
  isActive           Boolean @default(true)
  isGovernanceLocked Boolean @default(false)
  description        String?

  @@map("lookup_customer_types")
  @@schema("platform")
}

model LookupEngagementTier {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String  @unique
  isActive           Boolean @default(true)
  isGovernanceLocked Boolean @default(false)
  category           String?
  description        String?

  @@map("lookup_engagement_tiers")
  @@schema("platform")
}

model CustomerLogFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  fileName   String
  fileSize   BigInt
  fileType   String
  uploadedBy String
  blobUrl    String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_log_files")
  @@schema("platform")
}

model SmtpConfig {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  host       String
  port       Int
  username   String?
  password   String?
  secure     Boolean   @default(true)
  fromEmail  String
  fromName   String?
  isDefault  Boolean   @default(false)
  customerId String?   @unique @db.Uuid
  updatedAt  DateTime  @updatedAt
