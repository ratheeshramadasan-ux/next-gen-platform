model Application {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  customerId          String?  @map("customer_id") @db.Uuid
  name                String   @map("name")
  appCode             String?  @map("app_code")             // e.g. SAP_ECC_PRD
  category            String?  @map("category")             // ERP, CRM, Portal, Database, API
  applicationType     String?  @map("application_type")
  businessOwner       String?  @map("business_owner")
  technicalOwner      String?  @map("technical_owner")
  owner               String?  @map("owner")
  criticality         String?  @default("Medium") @map("criticality")  // Critical/High/Medium/Low
  description         String?  @map("description")
  status              String   @default("Active") @map("status")       // Active/Retired/Planned
  timezone            String   @default("UTC") @map("timezone")
  is24x7              Boolean  @default(false) @map("is_24x7")         // true = no operating hours restriction
  isActive            Boolean  @default(true) @map("is_active")
  sourceApplicationId String?  @map("source_application_id") @db.Uuid
  isLinked            Boolean  @default(false) @map("is_linked")
  resourceId          String?  @unique @map("resource_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant                Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource              Resource?                         @relation(fields: [resourceId], references: [id])
  versions              ApplicationVersion[]
  configs               ApplicationConfig[]
  downtimes             ApplicationDowntime[]
  availabilityOverrides ApplicationAvailabilityOverride[]
  replicationLogs       ApplicationReplicationLog[]       @relation("AppToLog")
  operatingHours        AppOperatingHours[]
  blackoutPeriods       AppBlackoutPeriod[]
  freezeWindows         AppFreezeWindow[]

  @@map("applications")
  @@schema("platform")
}

// Day-of-week operating hours per application
model AppOperatingHours {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  dayOfWeek     Int      @map("day_of_week")    // 0=Sun,1=Mon,...,6=Sat
  isClosed      Boolean  @default(false) @map("is_closed")
  startTime     String?  @map("start_time")     // "06:00" 24-hr format
  endTime       String?  @map("end_time")       // "22:00"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, dayOfWeek])
  @@map("app_operating_hours")
  @@schema("platform")
}

// Planned business blackout periods (financial close, year-end, etc.)
model AppBlackoutPeriod {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  name          String                                // "Month End Close", "Year End"
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isRecurring   Boolean  @default(false) @map("is_recurring")
  recurrenceRule String? @map("recurrence_rule")     // RRULE string or JSON
  botPolicy     String   @default("BLOCK") @map("bot_policy")  // ALLOW/BLOCK/APPROVAL_REQUIRED
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("app_blackout_periods")
  @@schema("platform")
}

// Emergency freeze windows (incidents, outages)
model AppFreezeWindow {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  reason        String
  startAt       DateTime  @map("start_at")
  endAt         DateTime? @map("end_at")              // null = open-ended
  isActive      Boolean   @default(true) @map("is_active")
  impact        String    @default("BLOCK_ALL") @map("impact")  // BLOCK_ALL/BLOCK_NEW/BLOCK_DEPLOY
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?   @map("resolved_by")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("app_freeze_windows")
  @@schema("platform")
}

