  assignedRole     String?  @map("assigned_role")
  formId           String?  @map("form_id")
  status           String   @default("PENDING")
  action           String?  // APPROVE | REJECT | DELEGATE | etc.
  actionBy         String?  @map("action_by")
  actionAt         DateTime? @map("action_at")
  actionReason     String?  @map("action_reason")
  signature        String?  // cryptographic signature
  dueAt            DateTime? @map("due_at")
  escalatedAt      DateTime? @map("escalated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  instance         FlowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("flow_human_tasks")
  @@schema("platform")
}

