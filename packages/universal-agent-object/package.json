{
  "name": "@nextgen/universal-agent-object",
  "version": "1.0.0",
  "description": "Universal Agent Object — self-contained cross-platform runtime for Windows, macOS, Linux, Docker and Kubernetes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "bundle:desktop": "tsup src/bootstrap.desktop.ts --outDir dist/bootstrap --no-dts --sourcemap",
    "bundle:container": "tsup src/bootstrap.container.ts --outDir dist/bootstrap --no-dts --sourcemap"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2"
  }
}

